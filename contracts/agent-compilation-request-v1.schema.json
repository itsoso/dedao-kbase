{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbase.executor.life/contracts/agent-compilation-request-v1.schema.json",
  "title": "KBase Agent Compilation Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "primary_release_id",
    "version"
  ],
  "properties": {
    "schema_version": { "const": "agent-compilation-request.v1" },
    "mode": { "enum": ["dual", "evidence", "study"] },
    "primary_release_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "supporting_release_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "research_enabled": { "type": "boolean" }
  }
}
