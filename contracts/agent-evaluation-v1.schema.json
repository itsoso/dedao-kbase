{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbase.executor.life/contracts/agent-evaluation-v1.schema.json",
  "title": "KBase Agent Evaluation Suite v1",
  "type": "object",
  "required": ["schema_version", "suite_version"],
  "properties": {
    "schema_version": { "const": "agent-evaluation.v1" },
    "suite_version": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "research_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/research_case" }
    }
  },
  "anyOf": [
    { "required": ["cases"] },
    { "required": ["research_cases"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "metric": {
      "enum": [
        "retrieval",
        "retrieval_precision",
        "citations",
        "faithfulness",
        "abstention",
        "tool_choice",
        "tool_arguments",
        "task_completion",
        "latency",
        "cost",
        "adjudication_consistency",
        "source_independence",
        "conflict_detection",
        "report_citation_completeness",
        "safe_insufficiency",
        "proofroom_projection_completeness"
      ]
    },
    "claim_gold": {
      "type": "object",
      "required": ["claim_identity"],
      "properties": {
        "claim_identity": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "verdict": {
          "enum": ["supported", "contradicted", "mixed", "insufficient"]
        },
        "conflict": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "metric"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "metric": { "$ref": "#/$defs/metric" },
        "input": { "type": "string", "minLength": 1 },
        "audit_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "expected_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_gold" }
        },
        "expected_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_value": { "type": "string" },
        "model_output": { "type": "string" },
        "proposed_tool": { "type": "string" },
        "proposed_arguments": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "expected_arguments": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "max_latency_ms": { "type": "integer", "minimum": 1 },
        "recorded_latency_ms": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric": {
                "enum": [
                  "adjudication_consistency",
                  "source_independence",
                  "conflict_detection",
                  "report_citation_completeness",
                  "safe_insufficiency",
                  "proofroom_projection_completeness"
                ]
              }
            },
            "required": ["metric"]
          },
          "then": { "required": ["audit_id"] }
        },
        {
          "if": {
            "properties": {
              "metric": { "const": "adjudication_consistency" }
            },
            "required": ["metric"]
          },
          "then": {
            "required": ["expected_claims"],
            "properties": {
              "expected_claims": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/claim_gold" },
                    { "required": ["verdict"] }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric": { "const": "conflict_detection" }
            },
            "required": ["metric"]
          },
          "then": {
            "required": ["expected_claims"],
            "properties": {
              "expected_claims": {
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/claim_gold" },
                    { "required": ["verdict", "conflict"] }
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "research_conclusion": {
      "type": "object",
      "required": ["claim_id", "evidence_ids"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "research_expected": {
      "type": "object",
      "required": ["outcome", "minimum_citation_coverage"],
      "properties": {
        "searched_sources": { "type": "array", "items": { "enum": ["knowledge", "chatlog", "prior_runs"] } },
        "identity_status": { "enum": ["resolved", "ambiguous", "not_found"] },
        "identity_id": { "type": "string" },
        "timeline_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "trend_direction": { "enum": ["up", "down", "flat", "mixed"] },
        "direct_advice_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflict_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "case_difference_dimensions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outcome": { "type": "string", "minLength": 1 },
        "failure_code": { "type": "string" },
        "material_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "minimum_citation_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "recovery_status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "research_observed": {
      "type": "object",
      "properties": {
        "searched_sources": { "type": "array", "items": { "enum": ["knowledge", "chatlog", "prior_runs"] } },
        "identity_status": { "enum": ["resolved", "ambiguous", "not_found"] },
        "identity_id": { "type": "string" },
        "timeline_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "numeric_values": { "type": "array", "items": { "type": "number" } },
        "reported_trend_direction": { "enum": ["up", "down", "flat", "mixed"] },
        "direct_advice_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflict_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "case_difference_dimensions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "transferred_amount": { "type": "string" },
        "recovery_status": { "type": "string" },
        "conclusions": { "type": "array", "items": { "$ref": "#/$defs/research_conclusion" } },
        "available_evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outcome": { "type": "string" },
        "failure_code": { "type": "string" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "private_projection_safe": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "research_case": {
      "type": "object",
      "required": ["case_id", "mode", "question", "expected", "observed", "max_latency_ms", "max_cost_usd"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["quick", "deep"] },
        "question": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/research_expected" },
        "observed": { "$ref": "#/$defs/research_observed" },
        "max_latency_ms": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
