{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbase.executor.life/contracts/agent-compilation-v1.schema.json",
  "title": "KBase Agent Compilation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "compilation_id",
    "mode",
    "assembly_id",
    "release_ids",
    "status",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "agent-compilation.v1" },
    "compiler_version": { "const": "deterministic-agent-compiler.v1" },
    "compilation_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["dual", "evidence", "study"] },
    "assembly_id": { "type": "string", "minLength": 1 },
    "release_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["ready", "partial", "blocked"] },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": { "enum": ["study", "evidence"] },
        "status": { "enum": ["ready", "blocked"] },
        "package": { "type": "object" },
        "issues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/issue" }
        },
        "next_actions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
