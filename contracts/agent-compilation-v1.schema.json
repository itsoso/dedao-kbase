{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kbase.executor.life/contracts/agent-compilation-v1.schema.json",
  "title": "KBase Agent Compilation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "compilation_id",
    "mode",
    "assembly_id",
    "release_ids",
    "status",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "agent-compilation.v1" },
    "compiler_version": { "const": "deterministic-agent-compiler.v1" },
    "compilation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["dual", "evidence", "study"] },
    "assembly_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "release_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "status": { "enum": ["ready", "partial", "blocked"] },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "study" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": { "kind": { "const": "study" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "evidence" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "properties": { "kind": { "const": "evidence" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "dual" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": { "kind": { "const": "study" } },
                  "required": ["kind"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": { "kind": { "const": "evidence" } },
                  "required": ["kind"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "ready" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "properties": { "status": { "const": "ready" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "blocked" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "properties": { "status": { "const": "blocked" } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "partial" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "candidates": {
            "allOf": [
              {
                "contains": {
                  "properties": { "status": { "const": "ready" } },
                  "required": ["status"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": { "status": { "const": "blocked" } },
                  "required": ["status"]
                },
                "minContains": 1
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": { "enum": ["study", "evidence"] },
        "status": { "enum": ["ready", "blocked"] },
        "package": {
          "oneOf": [
            { "$ref": "agent-package-v1.schema.json" },
            { "$ref": "agent-package-v2.schema.json" }
          ]
        },
        "issues": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/issue" }
        },
        "next_actions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          },
          "then": {
            "required": ["package"],
            "properties": {
              "issues": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": {
            "required": ["issues"],
            "properties": {
              "issues": { "minItems": 1 }
            },
            "not": { "required": ["package"] }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "study" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "package": { "$ref": "agent-package-v1.schema.json" }
            }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "evidence" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "package": { "$ref": "agent-package-v2.schema.json" }
            }
          }
        }
      ]
    }
  }
}
